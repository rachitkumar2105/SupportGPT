# --- required -------------------------------------------------------------
# 32+ random chars. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Groq keys. The secondary key is used automatically when the primary hits a rate limit.
GROQ_API_KEY_PRIMARY=          # GROQ_API_KEY is also accepted
GROQ_API_KEY_SECONDARY=
# Postgres in production (Neon works); SQLite is used if unset.
DATABASE_URL=sqlite:///./supportgpt.db
# Exact origins allowed to call the API with cookies. Never "*".
ALLOWED_ORIGINS=http://localhost:5173

# --- accounts -------------------------------------------------------------
# Created on first boot if missing. Use a long unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# One-click "try as agent" entry for portfolio visitors (no shared password).
DEMO_AGENT_ENABLED=false

# --- tuning ---------------------------------------------------------------
APP_ENV=development
COOKIE_SECURE=false            # true in production (HTTPS)
ABSTAIN_THRESHOLD=0.70         # calibrate with the Quality page / POST /api/admin/eval
ANSWER_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
TRIAGE_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant
SEED_KB=true
TRUSTED_PROXY_HOPS=2
