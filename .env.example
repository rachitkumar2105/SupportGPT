# Both Groq keys are required — the app fails to start if either is missing.
# The secondary key is used as automatic failover when the primary hits a
# rate limit / quota error (HTTP 429).
GROQ_API_KEY_PRIMARY=your_primary_groq_api_key
GROQ_API_KEY_SECONDARY=your_secondary_groq_api_key

# Required. Used to sign JWTs — the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_value

# Optional. Set to "true" to seed demo admin/developer accounts on startup —
# local/dev only, never enable in a public deployment.
SEED_DEMO_USERS=false

# Optional. Comma-separated list of origins allowed to call this API with
# credentials. Defaults to localhost origins if unset.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
